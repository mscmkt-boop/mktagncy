---
interface Props {
  name:
    | 'wrench'
    | 'document'
    | 'link'
    | 'map-pin'
    | 'pencil'
    | 'shopping-cart'
    | 'sparkles'
    | 'chart-bar'
    | 'code-bracket'
    | 'bolt'
    | 'magnifying-glass'
    | 'arrow-right'
    | 'check'
    | 'star';
