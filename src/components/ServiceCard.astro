---
import Icon from './Icon.astro';

interface Props {
  name: string;
  shortDescription: string;
  href: string;
  icon: Parameters<typeof Icon>[0]['name'];
}

const { name, shortDescription, href, icon } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col gap-4 rounded-lg border border-line bg-white p-6 transition-colors hover:border-signal"
>
  <span class="inline-flex h-11 w-11 items-center justify-center rounded-md bg-paper-dim text-signal">
    <Icon name={icon} class="h-6 w-6" />
  </span>
  <h3 class="text-lg font-semibold text-ink group-hover:text-signal">{name}</h3>
  <p class="text-sm text-slate">{shortDescription}</p>
  <span class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-signal">
    Learn more
    <Icon name="arrow-right" class="h-4 w-4" />
  </span>
</a>
