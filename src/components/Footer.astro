---
import { FOOTER_LEGAL_LINKS, NAV_LINKS, SITE } from '../lib/site';

const currentYear = new Date().getFullYear();
const serviceLinks = [
  { label: 'Technical SEO', href: '/services/technical-seo' },
  { label: 'On-Page SEO', href: '/services/on-page-seo' },
  { label: 'Local SEO', href: '/services/local-seo' },
  { label: 'AEO/GEO', href: '/services/aeo-geo-ai-search-visibility' },
  { label: 'SEO Audits', href: '/services/seo-audits' }
];
---

<footer class="border-t border-line bg-ink text-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-xl font-semibold text-paper">{SITE.name}</p>
      <p class="mt-3 max-w-xs text-sm">{SITE.tagline}</p>
    </div>

    <nav aria-label="Services">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-paper">Services</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {serviceLinks.map((link) => (
          <li><a href={link.href} class="hover:text-signal-bright">{link.label}</a></li>
        ))}
        <li><a href="/services" class="hover:text-signal-bright">View all services</a></li>
      </ul>
    </nav>

    <nav aria-label="Site">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-paper">Company</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href} class="hover:text-signal-bright">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-paper">Get in touch</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={`mailto:${SITE.email}`} class="hover:text-signal-bright">{SITE.email}</a></li>
        <li><a href={`tel:${SITE.phone.replace(/[^+\d]/g, '')}`} class="hover:text-signal-bright">{SITE.phone}</a></li>
        <li>{SITE.addressLocality}, {SITE.addressRegion}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-6 text-xs text-muted-on-dark sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {currentYear} {SITE.legalName}. All rights reserved.</p>
      <nav aria-label="Legal">
        <ul class="flex gap-4">
          {FOOTER_LEGAL_LINKS.map((link) => (
            <li><a href={link.href} class="hover:text-signal-bright">{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>
