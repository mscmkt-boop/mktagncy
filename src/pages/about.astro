---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';

const description =
  'Legwork builds affordable websites and runs the SEO/GEO work behind them, founded in 2019. Here is how we work, and who runs the engagements.';

const methodologySteps = [
  {
    title: "Build fast, without cutting what matters",
    body: 'Most sites launch in 3-4 weeks. We keep the price down by cutting agency overhead, not design quality or performance.'
  },
  {
    title: 'Visibility built in, not upsold later',
    body: "Every site ships with the SEO fundamentals already in place — clean markup, fast load times, basic schema. You're not paying twice to fix what should've been there at launch."
  },
  {
    title: 'Report on leads, not vanity metrics',
    body: "Rankings and traffic are leading indicators. We report on the leads and conversions those numbers are supposed to produce, because that's what you actually asked for."
  },
  {
    title: "Take it off your plate, on purpose",
    body: 'Care plans, ongoing SEO, and monthly check-ins mean staying visible online is our job to track, not one more thing added to yours.'
  }
];

const team = [
  { name: 'Maya Okonkwo', role: 'Founder & Web Development Lead', bio: 'Eleven years building and shipping sites for small businesses and professionals who needed something that actually worked, not just looked nice.' },
  { name: 'Devon Marsh', role: 'Technical SEO & Content Lead', bio: 'Built topical content and technical SEO programs for local service businesses and B2B brands for over a decade.' },
  { name: 'Priya Raman', role: 'AEO/GEO Lead', bio: 'Focused on AI search visibility and structured data since AI Overviews launched broadly.' },
  { name: 'Tom Alvarez', role: 'Analytics & Reporting Lead', bio: 'Handles GA4, GSC, and GTM implementation and the reporting layer across every account.' }
];
---

<BaseLayout title="About" description={description}>
  <Breadcrumbs items={[{ label: 'About', href: '/about' }]} />

  <section class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="text-4xl font-semibold text-ink sm:text-5xl">We started {SITE.name} because websites shouldn't be a five-figure expense to find out if they'll work.</h1>
    <p class="mt-6 text-lg text-slate">
      A website is a revenue channel and it's proof you're a legitimate business — it shouldn't cost like a luxury or take six months to ship. Founded in {SITE.founded}, {SITE.name} builds affordable, fast websites and runs the SEO/GEO work behind them, so business owners and professionals can stay focused on their craft while we handle the visibility.
    </p>
    <p class="mt-4 text-lg text-slate">
      We do the legwork: the build, the technical SEO, the content structure, the AI search visibility work that's genuinely time-consuming to do well. What comes back to you is plain — more leads, better conversion, a site you don't have to think about day to day.
    </p>
  </section>

  <section aria-labelledby="methodology-heading" class="border-y border-line bg-paper-dim">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <h2 id="methodology-heading" class="text-3xl font-semibold text-ink sm:text-4xl">How we work</h2>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2">
        {methodologySteps.map((step, index) => (
          <li class="rounded-lg border border-line bg-white p-6">
            <span class="font-display text-2xl font-semibold text-signal">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 text-lg font-semibold text-ink">{step.title}</h3>
            <p class="mt-2 text-sm text-slate">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="team-heading" class="mx-auto max-w-6xl px-6 py-16">
    <h2 id="team-heading" class="text-3xl font-semibold text-ink sm:text-4xl">Who you'll work with</h2>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {team.map((member) => (
        <li class="rounded-lg border border-line bg-white p-6">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-paper-dim text-signal">
            <Icon name="sparkles" class="h-6 w-6" />
          </span>
          <h3 class="mt-4 text-lg font-semibold text-ink">{member.name}</h3>
          <p class="text-sm font-medium text-signal">{member.role}</p>
          <p class="mt-2 text-sm text-slate">{member.bio}</p>
        </li>
      ))}
    </ul>
  </section>

  <Cta />
</BaseLayout>
