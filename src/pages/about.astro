---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';

const description =
  'Sparkline is a full-service SEO and AEO/GEO agency founded in 2019. Here is how we work, and who runs the engagements.';

const methodologySteps = [
  {
    title: 'Audit, not assumptions',
    body: 'Every engagement opens with a technical, content, and authority audit — plus an AI search visibility baseline. We diagnose before we prescribe.'
  },
  {
    title: 'Prioritize by impact, not checklist order',
    body: 'Findings get ranked by projected impact against implementation effort. You get a roadmap you can act on, not a 200-item spreadsheet.'
  },
  {
    title: 'Build for compounding, not isolated wins',
    body: 'Technical, content, and authority work is sequenced so each phase reinforces the next, instead of shipping disconnected wins that plateau.'
  },
  {
    title: 'Report on outcomes, not vanity metrics',
    body: 'Rankings and traffic are leading indicators. We report against the revenue and pipeline numbers those indicators are supposed to predict.'
  }
];

const team = [
  { name: 'Maya Okonkwo', role: 'Founder & Technical SEO Lead', bio: 'Eleven years in technical SEO, previously in-house at two Series C SaaS companies.' },
  { name: 'Devon Marsh', role: 'Head of Content Strategy', bio: 'Built topical content programs for B2B SaaS and e-commerce brands for over a decade.' },
  { name: 'Priya Raman', role: 'AEO/GEO Lead', bio: 'Focused on AI search visibility and structured data since AI Overviews launched broadly.' },
  { name: 'Tom Alvarez', role: 'Analytics & Reporting Lead', bio: 'Handles GA4, GSC, and GTM implementation and the reporting layer across every account.' }
];
---

<BaseLayout title="About" description={description}>
  <Breadcrumbs items={[{ label: 'About', href: '/about' }]} />

  <section class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="text-4xl font-semibold text-ink sm:text-5xl">We started {SITE.name} because most SEO reporting doesn't survive contact with a CFO.</h1>
    <p class="mt-6 text-lg text-slate">
      Founded in {SITE.founded}, {SITE.name} runs full-service SEO programs for marketing teams that already understand SEO and want a partner that can execute across technical, content, authority, and — more recently — AI search visibility, without treating any one of those as a silo.
    </p>
    <p class="mt-4 text-lg text-slate">
      We added AEO/GEO to the service line as AI Overviews and conversational search started meaningfully affecting visibility, not as a rebrand. The fundamentals — crawlability, structured data, clear entity naming, content that actually answers the question — were already the foundation of the work. AI search visibility is an extension of that foundation, not a replacement for it.
    </p>
  </section>

  <section aria-labelledby="methodology-heading" class="border-y border-line bg-paper-dim">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <h2 id="methodology-heading" class="text-3xl font-semibold text-ink sm:text-4xl">How we work</h2>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2">
        {methodologySteps.map((step, index) => (
          <li class="rounded-lg border border-line bg-white p-6">
            <span class="font-display text-2xl font-semibold text-signal">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 text-lg font-semibold text-ink">{step.title}</h3>
            <p class="mt-2 text-sm text-slate">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="team-heading" class="mx-auto max-w-6xl px-6 py-16">
    <h2 id="team-heading" class="text-3xl font-semibold text-ink sm:text-4xl">Who you'll work with</h2>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {team.map((member) => (
        <li class="rounded-lg border border-line bg-white p-6">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-paper-dim text-signal">
            <Icon name="sparkles" class="h-6 w-6" />
          </span>
          <h3 class="mt-4 text-lg font-semibold text-ink">{member.name}</h3>
          <p class="text-sm font-medium text-signal">{member.role}</p>
          <p class="mt-2 text-sm text-slate">{member.bio}</p>
        </li>
      ))}
    </ul>
  </section>

  <Cta />
</BaseLayout>
