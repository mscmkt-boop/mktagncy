---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Cta from '../../components/Cta.astro';
import { SITE } from '../../lib/site';

const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const pillars = [
  {
    name: 'Web Development',
    blurb: 'A fast, affordable site built to actually generate leads — plus the care plans to keep it that way.',
    services: allServices.filter((s) => s.data.pillar === 'Web Development')
  },
  {
    name: 'SEO & AI Search Visibility',
    blurb: 'Every discipline that drives organic performance, from technical fundamentals to AI answer engines.',
    services: allServices.filter((s) => s.data.pillar === 'SEO & AI Search Visibility')
  }
];

const description =
  'Affordable website design and development plus full-service SEO and AI search visibility (AEO/GEO) — the two things that turn a website into a lead-generation channel.';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: allServices.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/services/${service.id}`, SITE.url).toString(),
    name: service.data.name
  }))
};
---

<BaseLayout title="Services" description={description} structuredData={itemListSchema}>
  <Breadcrumbs items={[{ label: 'Services', href: '/services' }]} />

  <section class="mx-auto max-w-6xl px-6 py-16">
    <h1 class="max-w-3xl text-4xl font-semibold text-ink sm:text-5xl">Two things that actually move revenue: a website worth finding, and getting found.</h1>
    <p class="mt-6 max-w-2xl text-lg text-slate">
      Web development and SEO/GEO are our two core services — everything else below is a discipline within one of them. You focus on your craft. We handle the site, the visibility, and the leads it's supposed to produce.
    </p>
  </section>

  {pillars.map((pillar) => (
    <section aria-labelledby={`pillar-${pillar.name}`} class="mx-auto max-w-6xl px-6 pb-20">
      <div class="max-w-2xl border-b border-line pb-6">
        <h2 id={`pillar-${pillar.name}`} class="text-2xl font-semibold text-ink sm:text-3xl">{pillar.name}</h2>
        <p class="mt-2 text-slate">{pillar.blurb}</p>
      </div>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {pillar.services.map((service) => (
          <li>
            <ServiceCard
              name={service.data.name}
              shortDescription={service.data.shortDescription}
              href={`/services/${service.id}`}
              icon={service.data.icon}
            />
          </li>
        ))}
      </ul>
    </section>
  ))}

  <Cta />
</BaseLayout>
